{
  "scripts": {
    "build": "wp-scripts build",
    "build:admin": "wp-scripts build src-admin/admin.js --output-path=./build/admin",
    "start:admin": "wp-scripts start src-admin/admin.js --output-path=./build/admin",
    "build:frontend": "wp-scripts build src-frontend/frontend.js --output-path=./build/frontend",
    "start:frontend": "wp-scripts start src-frontend/frontend.js --output-path=./build/frontend"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.9.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
